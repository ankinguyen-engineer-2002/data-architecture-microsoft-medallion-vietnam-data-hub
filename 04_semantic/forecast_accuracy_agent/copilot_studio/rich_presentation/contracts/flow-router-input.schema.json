{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rich Presentation Router input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "evidenceStatus",
    "interactionMode",
    "resultShape",
    "metricCount",
    "rowCount",
    "seriesPointCount",
    "channelProfile",
    "supportsRichTrend",
    "presentationHint"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "evidenceStatus": {
      "enum": ["OK", "NO_GOVERNED_EVIDENCE", "INVALID_QUERY", "UNAUTHORIZED", "ERROR", "STALE"]
    },
    "interactionMode": { "enum": ["READ_ONLY", "FLASHCARD_REVIEW", "GOVERNANCE_DRAFT"] },
    "workflowId": { "const": "forecast_governance_draft" },
    "conceptId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "resultShape": { "enum": ["NONE", "SCALAR", "SERIES", "TABLE"] },
    "metricCount": { "type": "integer", "minimum": 0, "maximum": 25 },
    "rowCount": { "type": "integer", "minimum": 0, "maximum": 25 },
    "seriesPointCount": { "type": "integer", "minimum": 0, "maximum": 25 },
    "channelProfile": { "enum": ["WEB_RICH_V1", "TEAMS_AC15", "M365_LIMITED", "COPILOT_TEST"] },
    "supportsRichTrend": { "type": "boolean" },
    "presentationHint": { "enum": ["AUTO", "KPI_CARD", "TABLE", "TREND", "FLASHCARD", "FORM", "TEXT_FALLBACK"] }
  }
}
