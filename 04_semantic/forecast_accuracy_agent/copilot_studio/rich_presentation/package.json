{
  "name": "supplychainagent-rich-presentation-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run validate:artifacts && npm test && npm run build",
    "validate:artifacts": "python3 tests/validate_artifacts.py",
    "test": "tsc -p tsconfig.test.json && node --test .tmp/rich-presentation-tsc/tests/resolver.test.js",
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
