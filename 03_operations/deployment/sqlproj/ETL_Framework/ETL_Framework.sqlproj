<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />
  <PropertyGroup>
    <Name>ETL_Framework</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlDwUnifiedDatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <SuppressMissingDependenciesErrors>True</SuppressMissingDependenciesErrors>
    <RunSqlCodeAnalysis>False</RunSqlCodeAnalysis>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.FabricDw" Version="170.0.4" />
    <SqlCmdVariable Include="ETL_Framework">
      <DefaultValue>ETL_Framework</DefaultValue>
      <Value>ETL_Framework</Value>
    </SqlCmdVariable>
    <SqlCmdVariable Include="SupplyChain_Processing_Warehouse">
      <DefaultValue>SupplyChain_Processing_Warehouse</DefaultValue>
      <Value>SupplyChain_Processing_Warehouse</Value>
    </SqlCmdVariable>
    <SqlCmdVariable Include="SupplyChain_Gold_Warehouse">
      <DefaultValue>SupplyChain_Gold_Warehouse</DefaultValue>
      <Value>SupplyChain_Gold_Warehouse</Value>
    </SqlCmdVariable>
    <SqlCmdVariable Include="Enterprise_Lakehouse">
      <DefaultValue>Enterprise_Lakehouse</DefaultValue>
      <Value>Enterprise_Lakehouse</Value>
    </SqlCmdVariable>
  </ItemGroup>
  <ItemGroup>
    <Build Remove="_package\**\*" />
    <None Include="_package\**\*" />
  </ItemGroup>
  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
</Project>
