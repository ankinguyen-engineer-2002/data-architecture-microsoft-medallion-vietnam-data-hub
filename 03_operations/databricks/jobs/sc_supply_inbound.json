{
  "name": "sc_supply_inbound",
  "description": "[Reconstructed] PO snapshot, Logility container, supply plan, MOMAST. MO daily is incremental in Inventory run_order.",
  "schedule": { "quartz_cron_expression": "0 35 2 * * ?", "timezone_id": "UTC", "pause_status": "UNPAUSED" },
  "max_concurrent_runs": 1,
  "timeout_seconds": 5400,
  "tasks": [
    {
      "task_key": "load_inbound",
      "spark_python_task": {
        "python_file": "notebooks/sc_supply_inbound.py",
        "parameters": ["--catalog", "edw_dev", "--mo_lookback_days", "14"]
      },
      "job_cluster_key": "sc_jobs"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "sc_jobs",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_D8ds_v5",
        "autoscale": { "min_workers": 2, "max_workers": 8 },
        "data_security_mode": "USER_ISOLATION",
        "autotermination_minutes": 10
      }
    }
  ]
}
