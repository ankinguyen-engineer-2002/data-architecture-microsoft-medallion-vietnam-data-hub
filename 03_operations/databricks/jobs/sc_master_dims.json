{
  "name": "sc_master_dims",
  "description": "[Reconstructed] Current-state masters both marts share (item, date, vendor, warehouse, customer grouping).",
  "schedule": { "quartz_cron_expression": "0 10 1 * * ?", "timezone_id": "UTC", "pause_status": "UNPAUSED" },
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "tasks": [
    {
      "task_key": "load_dims",
      "spark_python_task": {
        "python_file": "notebooks/sc_master_dims.py",
        "parameters": ["--catalog", "edw_dev"]
      },
      "job_cluster_key": "sc_jobs"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "sc_jobs",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "autoscale": { "min_workers": 2, "max_workers": 6 },
        "data_security_mode": "USER_ISOLATION",
        "autotermination_minutes": 10
      }
    }
  ]
}
