{
  "name": "sc_codis_orders",
  "description": "[Reconstructed] Wholesale CODIS files EXTORD/EXTORIT/COMAST used by Forecast open-order history.",
  "schedule": { "quartz_cron_expression": "0 25 1 * * ?", "timezone_id": "UTC", "pause_status": "UNPAUSED" },
  "max_concurrent_runs": 1,
  "timeout_seconds": 5400,
  "tasks": [
    {
      "task_key": "load_codis",
      "spark_python_task": {
        "python_file": "notebooks/sc_codis_orders.py",
        "parameters": ["--catalog", "edw_dev"]
      },
      "job_cluster_key": "sc_jobs"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "sc_jobs",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_D8ds_v5",
        "autoscale": { "min_workers": 2, "max_workers": 8 },
        "data_security_mode": "USER_ISOLATION",
        "autotermination_minutes": 10
      }
    }
  ]
}
