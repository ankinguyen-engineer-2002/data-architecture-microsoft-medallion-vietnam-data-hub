  "structure": {
    "forecast_accuracy": {
      "Silver": {
        "W00_parallel_11": ["ReferenceMaster_Enh (11 tables: Calendar..Warehouse)"],
        "W01_parallel_2": ["SalesHistory_Enh.InvoiceDetailLineLevel", "OpenOrderHistory_Enh.OpenOrderLineLevel"],
        "W02_parallel_5": ["SalesHistory_Enh (ActualDemandMonthly, ActualDemandWeekly, InvoiceWeekly)", "ForecastHistory_Enh.ForecastDemandMonthly", "OpenOrderHistory_Enh.OpenOrderMonthly"],
        "W03_1": ["ForecastHistory_Enh.NaiveForecastMonthly"]
      },
      "Gold": {
        "W01_parallel_3": ["Shared_DW (DimCalendar, DimProduct, DimWarehouse)"],
        "W10_parallel_2": ["ForecastAccuracy_DW (DimCustomerGrouping, DimForecastHorizon)"],
        "W30_parallel_2": ["ForecastAccuracy_DW (FactForecastActual, FactForecastKpi)"]
      }
    },
    "inventory_health": {
      "Silver": {
        "W00_parallel_2": ["InventoryHistory_Enh (InventorySnapshotWeekly, AtpWeekEnding)"],
        "W01_parallel_8": ["InventoryHistory_Enh (PO historical, MO daily(INC), HoldingTransfer(INC), ForecastSnapshotWeekly, SupplyPlanDetail, ItemBalanceHistorical, SafetyStockHelper)", "SalesHistory_Enh.InvoiceDetailLineLevel"],
        "W02_parallel_4": ["InventoryHistory_Enh (AFIStatusSnapshot, AwdHelper, LastInvoiceWeekly, Cogs52WWeekly)"]
      },
      "Gold": {
        "W10_1": ["InventoryHealth_DW.DimVendor"],
        "W20_parallel_2": ["InventoryHealth_DW (ProjectedIHSubStatus, IHSubStatusWeekly)"],
        "W21_1": ["InventoryHealth_DW.InventoryClassificationQtyWeekly (AFTER IHSubStatusWeekly)"],
        "W30_parallel_2": ["InventoryHealth_DW (FactIHFutureWeekEnding, FactIHSnapshot)"]
      }
    }
  },
  "concurrency": "Within each wave, all tables execute in parallel (no inter-dependency). Between waves, strict sequential chain via dependsOn: [all activities from previous wave] with DependencyConditions: [Succeeded].",
  "note": "Shared tables (ReferenceMaster_Enh, Shared_DW) run only ONCE in Forecast. Inventory reuses them."
