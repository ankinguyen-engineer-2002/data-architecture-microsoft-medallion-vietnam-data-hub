        formatString: 0.0000
        summarizeBy: sum

    column FirmPurchaseOrderQty
        dataType: decimal
        formatString: 0.0000
        summarizeBy: sum

    column PlannedPurchaseOrderQty
        dataType: decimal
        formatString: 0.0000
        summarizeBy: sum

    column OnOrderTransferInQty
        dataType: decimal
        formatString: 0.0000
        summarizeBy: sum

    column ShippableInventoryQty
        dataType: decimal
        formatString: 0.0000
        summarizeBy: sum

    column SafetyStockTargetQty
