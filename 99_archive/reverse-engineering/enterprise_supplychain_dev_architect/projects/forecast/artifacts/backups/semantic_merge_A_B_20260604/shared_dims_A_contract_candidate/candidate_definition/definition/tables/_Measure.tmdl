	measure wMAPE_Lag4_FontColor = ```
			
			VAR Pct_wMAPE_Lag0 = CALCULATE([Pct_wMAPE_Lag0], ALL(dim_forecast_horizon[code_horizon]))
			VAR Pct_wMAPE_Lag1 = CALCULATE([Pct_wMAPE_Lag1], ALL(dim_forecast_horizon[code_horizon]))
			VAR Pct_wMAPE_Lag2 = CALCULATE([Pct_wMAPE_Lag2], ALL(dim_forecast_horizon[code_horizon] ))
			VAR Pct_wMAPE_Lag3 = CALCULATE([Pct_wMAPE_Lag3], ALL(dim_forecast_horizon[code_horizon]))
			VAR Pct_wMAPE_Lag4 = CALCULATE([Pct_wMAPE_Lag4], ALL(dim_forecast_horizon[code_horizon]))
			VAR CurrentValue = Pct_wMAPE_Lag4
			VAR Rankk =
			    (IF(Pct_wMAPE_Lag0 < CurrentValue, 1, 0)) +
			    (IF(Pct_wMAPE_Lag1 < CurrentValue, 1, 0)) +
			    (IF(Pct_wMAPE_Lag2 < CurrentValue, 1, 0)) +
			    (IF(Pct_wMAPE_Lag3 < CurrentValue, 1, 0)) +
			    (IF(Pct_wMAPE_Lag4 <= CurrentValue, 1, 0)) 
			RETURN
			    SWITCH(
			        Rankk,
			        1, "#99FF33",
