	measure Forecast_Accuracy_Insight_3_1_Quarter = ```
			
			VAR CurrentDate = 
			    LOOKUPVALUE(
			        'dim_calendar'[dt_fsc_quarter_last], 
			        'dim_calendar'[num_fsc_quarter_indicator], 0
			    )
			VAR FirstDayOfCurrentMonth = DATE(YEAR(CurrentDate), QUARTER(CurrentDate), 1)
			
			-- Lùi lại 1,2 quý và 3 quý
			
			VAR Quarter_1 = LOOKUPVALUE(
			        'dim_calendar'[dt_fsc_quarter_last], 
			        'dim_calendar'[num_fsc_quarter_indicator], -1
			    )
			
			VAR Quarter_2 = LOOKUPVALUE(
			        'dim_calendar'[dt_fsc_quarter_last], 
			        'dim_calendar'[num_fsc_quarter_indicator], -2
			    )
			VAR Quarter_3 = LOOKUPVALUE(
			        'dim_calendar'[dt_fsc_quarter_last], 
			        'dim_calendar'[num_fsc_quarter_indicator], -3
			    )
			
			-- Định dạng nhãn: "Q2 2025"
			VAR Label_Q1 = FORMAT(Quarter_1, "\Qq yyyy")
			VAR Label_Q2 = FORMAT(Quarter_2, "\Qq yyyy")
			VAR Label_Q3 = FORMAT(Quarter_3, "\Qq yyyy")
			
			-- Tính toán cho Quý -1 (Quý gần nhất)
			VAR Actual_Q1 = 
			    CALCULATE(
			        SUM('fact_flat_forecast_actual'[qty]), 
			         'fact_flat_forecast_actual'[code_horizon] = "Actual demand",
			         'fact_flat_forecast_actual'[dt_fsc_month_last] = Quarter_1)
			
			-- Tính toán cho Quý -2 
			VAR Lag0_Q2 = 
			    CALCULATE(
			        SUM('fact_flat_forecast_actual'[qty]), 
			        'fact_flat_forecast_actual'[code_horizon] = "Lag-0",
			        'dim_calendar'[dt_fsc_quarter_last] = Quarter_2
			    )
			VAR Actual_Q2 = 
			    CALCULATE(
			        SUM('fact_flat_forecast_actual'[qty]), 
			         'fact_flat_forecast_actual'[code_horizon] = "Actual demand",
			         'dim_calendar'[dt_fsc_quarter_last] = Quarter_2)
			
			-- Tính toán cho Quý -3
			VAR Lag0_Q3 = 
			    CALCULATE(
			        SUM('fact_flat_forecast_actual'[qty]), 
			        'dim_forecast_horizon'[code_horizon] = "Lag-0",
			        'dim_calendar'[dt_fsc_quarter_last] = Quarter_3
			    )
			VAR Actual_Q3 = 
			    CALCULATE(
			        SUM('fact_flat_forecast_actual'[qty]), 
			        'dim_forecast_horizon'[code_horizon] = "Actual demand",
			        'dim_calendar'[dt_fsc_quarter_last] = Quarter_3
			    )
			
			-- Định dạng số có dấu phẩy (Thêm units trực tiếp vào định dạng để gọn mã)
			VAR Actual_Q1_Fmt = FORMAT(Actual_Q1, "#,0") & " units"
			VAR Lag0_Q2_Fmt = FORMAT(Lag0_Q2, "#,0") & " units"
			VAR Actual_Q2_Fmt = FORMAT(Actual_Q2, "#,0") & " units"
			VAR Lag0_Q3_Fmt = FORMAT(Lag0_Q3, "#,0") & " units"
			VAR Actual_Q3_Fmt = FORMAT(Actual_Q3, "#,0") & " units"
			
			-- Trả về chuỗi kết quả
			RETURN 
			    "- Lag-0 tracks actuals closely: " & 
			    IF(
			        ISBLANK(Lag0_Q2) && ISBLANK(Actual_Q2), 
			        "No data for " & Label_Q2, 
			        Label_Q2 & " (" & Lag0_Q2_Fmt & " vs " & Actual_Q2_Fmt & ")"
			    ) 
			    & ", " & 
			    IF(
			        ISBLANK(Lag0_Q3) && ISBLANK(Actual_Q3), 
			        "No data for " & Label_Q3, 
			        Label_Q3 & " (" & Lag0_Q3_Fmt & " vs " & Actual_Q3_Fmt & ")"
			    ) & ". The actual demand for " & Label_Q1 & " is " & Actual_Q1_Fmt
			```
		displayFolder: 3. Narrative
		lineageTag: e661f81f-1699-4653-b6d6-63ad6fa7be4f

