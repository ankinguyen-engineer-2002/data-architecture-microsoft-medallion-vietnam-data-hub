	measure ForecastAccuracy_lq_Status = ```
			
			VAR CurrentMonthCount =
			    COUNTROWS(VALUES(dim_calendar[num_fsc_month_year]))
			
			VAR CurrentFA =
			    [Pct_ForecastAccuracy]
			
			VAR CompareFA =
			    [Pct_ForecastAccuracy_lq]
			
			VAR Gap =
			    CurrentFA - CompareFA
			
			VAR FormatGap =
			    FORMAT(Gap, "+0.0%;-0.0%;0.0%")
			
			VAR CompareLabel =
			    IF(CurrentMonthCount = 1, "LQ", "Prior Window")
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(CurrentFA) || ISBLANK(CompareFA), BLANK(),
			    Gap > 0, "Growth " & FormatGap & " vs " & CompareLabel,
			    Gap < 0, "Decrease " & FormatGap & " vs " & CompareLabel,
			    "No change vs " & CompareLabel
			)
			 
			```
		displayFolder: 3. Narrative
		lineageTag: f7c734ca-329b-4e9e-b180-e65f2e4fe9f0

