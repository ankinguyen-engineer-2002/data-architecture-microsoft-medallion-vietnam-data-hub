			    ),
			    BLANK()
			)
		displayFolder: 1. Main KPIs - Forecast Accuracy
		lineageTag: 87330796-96b6-4155-8a50-6c309eb55b59

		annotation PBI_FormatHint = {"isGeneralNumber":true}

