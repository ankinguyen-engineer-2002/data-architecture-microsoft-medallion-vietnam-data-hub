	measure Dynamic_Forecast_Insight_1_Quarter = ```
			
			-- 1. Khai báo biến dữ liệu đầu vào
			VAR _wMAPE_Lag3 = [Pct_wMAPE_Lag3]
			VAR _wMAPE_Naive = [Pct_NwMAPE]
			VAR _Qty = [Qty_Bias]
			VAR _NQty = [Qty_NBias]
			VAR _Raw_Min = [Selected_Quarter_Min]
			VAR _Raw_Max = [Selected_Quarter_Max]
			
			-- 2. Định dạng các con số thành văn bản (Text)
			VAR _Txt_Lag3 = FORMAT(_wMAPE_Lag3, "0.0%")
			VAR _Txt_Naive = FORMAT(_wMAPE_Naive, "0.0%")
			VAR _Txt_Add = FORMAT(ABS(_wMAPE_Lag3 - _wMAPE_Naive) * 100, "0.0") & "pp"
			VAR _Txt_Qty = FORMAT(ABS(_Qty), "#,0")
			VAR _Txt_NQty = FORMAT(ABS(_NQty), "#,0")
			
			-- 3. Logic so sánh Performance (wMAPE thấp hơn = Overperforms)
			VAR _Performance = IF(_wMAPE_Lag3 < _wMAPE_Naive, "overperforms", "underperforms")
			
			-- 4. Logic Bias Status
			VAR _Bias_Status = IF(_Qty < 0, "under-forecasts", "over-forecasts")
			VAR _NBias_Status = IF(_NQty < 0, "under-forecasts", "over-forecasts")
			
			-- 5. Xử lý logic hiển thị Thời gian (The period in vs The period from...to)
			VAR _Quarter_Min_Txt = FORMAT(_Raw_Min, "\Qq yyyy")
			VAR _Quarter_Max_Txt = FORMAT(_Raw_Max, "\Qq yyyy")
			
			VAR _Period_Txt = 
			    IF(
			        _Raw_Min = _Raw_Max, 
			        "The period in " & _Quarter_Min_Txt, 
			        "The period from " & _Quarter_Min_Txt & " to " & _Quarter_Max_Txt
			    )
			
			-- 6. Kết hợp chuỗi bằng dấu & để tránh lỗi Matching Type
			RETURN
			"Lag-3 (wMAPE " & _Txt_Lag3 & ") " & 
			_Performance & " Naive Forecast (N_wMAPE " & _Txt_Naive & ") " & 
			"by " & _Txt_Add & ". " & 
			_Period_Txt & " " & 
			_Bias_Status & " by " & _Txt_Qty & " units, while Naive " & 
			_NBias_Status & " by " & _Txt_NQty & " units."
			```
		displayFolder: 3. Narrative
		lineageTag: b89c1ce6-6fc5-4f4e-ba98-38689a5e7b27

