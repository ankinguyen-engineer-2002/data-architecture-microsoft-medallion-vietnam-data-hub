	measure Forecast_Accuracy_Insight_3_2_Quarter = ```
			
			VAR LatestQuarter = 
			    LOOKUPVALUE(
			        'dim_calendar'[dt_fsc_quarter_last], 
			        'dim_calendar'[num_fsc_quarter_indicator], 0
			    )
			
			VAR Period3Q = 
			    DATESINPERIOD(
			        'dim_calendar'[dt_fsc_quarter_last], 
			        LatestQuarter, 
			        -3, 
			        QUARTER
			    )
			
			-- Use DATATABLE to create a clean, named virtual table
			VAR TargetLags = 
			    DATATABLE(
			        "LagName", STRING, 
			        {
			            {"Lag-0"}, {"Lag-1"}, {"Lag-2"}, {"Lag-3"}, {"Lag-4"}
			        }
			    )
			
			-- Create the virtual table calculating Bias
			VAR BiasTable = 
			    GENERATE(
			        Period3Q, 
			        VAR CurrentQuarter = [dt_fsc_quarter_last]
			        VAR ActualQty = 
			            CALCULATE(
			                SUM(fact_flat_forecast_actual[qty]),
			                fact_flat_forecast_actual[code_horizon] = "Actual demand",
			                dim_calendar[dt_fsc_quarter_last] = CurrentQuarter
			            )
			        RETURN
			            SELECTCOLUMNS(
			                TargetLags,
			                "Lag", [LagName],
			                "BiasValue", 
			                    -- Capture the current row's LagName into a variable
			                    VAR CurrentLag = [LagName] 
			                    RETURN
			                    CALCULATE(
			                        SUM(fact_flat_forecast_actual[qty]),
			                        fact_flat_forecast_actual[code_horizon] = CurrentLag,
			                        dim_calendar[dt_fsc_quarter_last] = CurrentQuarter
			                    ) - ActualQty
			            )
			    )
			
			RETURN
			    "- Spread across lags stays tight at "&FORMAT(MEDIANX(BiasTable, [BiasValue]),"#,##0")&" units for most quarters."
			```
		displayFolder: 3. Narrative
		lineageTag: 62f42ea6-6fa4-43b3-9655-feae8a8f0050

