	measure Forecast_Accuracy_Insight_3_5_Quarter = ```
			
			VAR _IndicatorRange = GENERATESERIES(Min(dim_calendar[num_fsc_quarter_indicator]), Max(dim_calendar[num_fsc_quarter_indicator]), 1) -- Tạo dãy số từ -6 đến 0
			
			RETURN
			CONCATENATEX(
			    _IndicatorRange,
			    VAR _CurrentInd = [Value]
			    
			    -- 1. Xác định tháng mục tiêu dựa trên Indicator
			    VAR _TargetQuarter = 
			        LOOKUPVALUE(
			            'dim_calendar'[dt_fsc_quarter_last], 
			            'dim_calendar'[num_fsc_quarter_indicator], _CurrentInd
			        )
			    VAR _QuarterName = FORMAT(_TargetQuarter, "mmm yyyy")
			
			    -- 2. Tính Actual của quý đó
			    VAR _Actual = 
			        CALCULATE(
			            SUM('fact_flat_forecast_actual'[qty]), 
			            'fact_flat_forecast_actual'[code_horizon] = "Actual demand",
			            'dim_calendar'[dt_fsc_quarter_last] = _TargetQuarter
			        )
			
			    -- 3. Tạo bảng chứa các Version Forecast (loại bỏ Actual/Naive)
			    VAR _ForecastTable = 
			        FILTER(
			            SUMMARIZE(
			                CALCULATETABLE(
			                    'fact_flat_forecast_actual',
			                    'dim_calendar'[dt_fsc_quarter_last] = _TargetQuarter
			                ),
			                'fact_flat_forecast_actual'[code_horizon], 
			                "TotalQty", SUM('fact_flat_forecast_actual'[qty])
			            ),
			            NOT 'fact_flat_forecast_actual'[code_horizon] IN {"Actual demand", "Naive forecast"}
			        )
			
			    -- 4. Lọc các version bị Under-forecast
			    VAR _UnderForecastTable = FILTER(_ForecastTable, [TotalQty] < _Actual)
			    VAR _CountUnder = COUNTROWS(_UnderForecastTable)
			    VAR _TotalVersions = COUNTROWS(_ForecastTable)
			
			    -- 5. Logic xác định "Mixed": Có ít nhất 1 cái thấp hơn và ít nhất 1 cái cao hơn (hoặc đơn giản là không phải tất cả đều cao hơn/thấp hơn)
			    -- Ở đây tôi lấy điều kiện: Có version bị Under nhưng không phải toàn bộ 100% version đều bị Under (Mixed)
			    VAR _IsMixed = _CountUnder > 0 && _CountUnder < _TotalVersions
			
			    -- 6. Format nội dung cho các version bị Under
			    VAR _UnderDetails = 
			        CONCATENATEX(
			            _UnderForecastTable, 
			            'fact_flat_forecast_actual'[code_horizon] & " (" & FORMAT([TotalQty]/1000, "#,0K") & ")", 
			            ", "
			        )
			
			    RETURN 
			        IF(
			            _IsMixed && NOT ISBLANK(_Actual),
			            "- Only " & _QuarterName & ": Actual " & FORMAT(_Actual/1000, "#,0K") & 
			            " | Under-forecast Lags: " & _UnderDetails,
			            BLANK()
			        ),
			    UNICHAR(10) -- Xuống dòng giữa các quý
			)
			```
		displayFolder: 3. Narrative
		lineageTag: 9f347cdd-37a8-4e46-8a54-3c9cd1de8424

	measure Forecast_Accuracy_Insight_3_5_Month = ```
			
			VAR _IndicatorRange = GENERATESERIES(Min(dim_calendar[num_fsc_month_indicator]), Max(dim_calendar[num_fsc_month_indicator]), 1) -- Tạo dãy số từ -6 đến 0
			
			RETURN
			CONCATENATEX(
			    _IndicatorRange,
			    VAR _CurrentInd = [Value]
			    
			    -- 1. Xác định tháng mục tiêu dựa trên Indicator
			    VAR _TargetMonth = 
			        LOOKUPVALUE(
			            'dim_calendar'[dt_fsc_month_last], 
			            'dim_calendar'[num_fsc_month_indicator], _CurrentInd
			        )
			    VAR _MonthName = FORMAT(_TargetMonth, "mmm yyyy")
			
			    -- 2. Tính Actual của tháng đó
			    VAR _Actual = 
			        CALCULATE(
			            SUM('fact_flat_forecast_actual'[qty]), 
			            'fact_flat_forecast_actual'[code_horizon] = "Actual demand",
			            'fact_flat_forecast_actual'[dt_fsc_month_last] = _TargetMonth
			        )
			
			    -- 3. Tạo bảng chứa các Version Forecast (loại bỏ Actual/Naive)
			    VAR _ForecastTable = 
			        FILTER(
			            SUMMARIZE(
			                CALCULATETABLE(
			                    'fact_flat_forecast_actual',
			                    'fact_flat_forecast_actual'[dt_fsc_month_last] = _TargetMonth
			                ),
			                'fact_flat_forecast_actual'[code_horizon], 
			                "TotalQty", SUM('fact_flat_forecast_actual'[qty])
			            ),
			            NOT 'fact_flat_forecast_actual'[code_horizon] IN {"Actual demand", "Naive forecast"}
			        )
			
			    -- 4. Lọc các version bị Under-forecast
			    VAR _UnderForecastTable = FILTER(_ForecastTable, [TotalQty] < _Actual)
			    VAR _CountUnder = COUNTROWS(_UnderForecastTable)
			    VAR _TotalVersions = COUNTROWS(_ForecastTable)
			
			    -- 5. Logic xác định "Mixed": Có ít nhất 1 cái thấp hơn và ít nhất 1 cái cao hơn (hoặc đơn giản là không phải tất cả đều cao hơn/thấp hơn)
			    -- Ở đây tôi lấy điều kiện: Có version bị Under nhưng không phải toàn bộ 100% version đều bị Under (Mixed)
			    VAR _IsMixed = _CountUnder > 0 && _CountUnder < _TotalVersions
			
			    -- 6. Format nội dung cho các version bị Under
			    VAR _UnderDetails = 
			        CONCATENATEX(
			            _UnderForecastTable, 
			            'fact_flat_forecast_actual'[code_horizon] & " (" & FORMAT([TotalQty]/1000, "#,0K") & ")", 
			            ", "
			        )
			
			    RETURN 
			        IF(
			            _IsMixed && NOT ISBLANK(_Actual),
			            "- Only " & _MonthName & ": Actual " & FORMAT(_Actual/1000, "#,0K") & 
			            " | Under-forecast Lags: " & _UnderDetails,
			            BLANK()
			        ),
			    UNICHAR(10) -- Xuống dòng giữa các tháng
			)
			```
		displayFolder: 3. Narrative
		lineageTag: b5836f2a-c3db-4a46-a301-2d6a66016e22

	measure Forecast_Accuracy_Insight_3_4_Quarter = ```
			
			VAR _TargetQuarter = LOOKUPVALUE(
			        'dim_calendar'[dt_fsc_quarter_last], 
			        'dim_calendar'[num_fsc_quarter_indicator], -1
			    )
			VAR _QuarterName = FORMAT(_TargetQuarter, "\Qq yyyy")
			
			-- 1. Lấy giá trị Actual
			VAR _Actual = 
			    CALCULATE(
			        SUM('fact_flat_forecast_actual'[qty]), 
			        'fact_flat_forecast_actual'[code_horizon] = "Actual demand",
			        'dim_calendar'[dt_fsc_quarter_last] = _TargetQuarter
			    )
			
			-- 2. Tạo bảng ảo chứa các Version Forecast (Loại bỏ Actual và Naive)
			VAR _ForecastTable = 
			    FILTER(
			        SUMMARIZE(
			            CALCULATETABLE(
			                'fact_flat_forecast_actual',
			                'dim_calendar'[dt_fsc_quarter_last] = _TargetQuarter
			            ),
			            'fact_flat_forecast_actual'[code_horizon], 
			            "TotalQty", SUM('fact_flat_forecast_actual'[qty])
			        ),
			        NOT 'fact_flat_forecast_actual'[code_horizon] IN {"Actual demand", "Naive forecast"}
			    )
			
			-- 3. Đếm số lượng version bị thấp hơn Actual
			VAR _UnderForecastTable = FILTER(_ForecastTable, [TotalQty] < _Actual)
			VAR _CountUnder = COUNTROWS(_UnderForecastTable)
			
			-- 4. Tạo chuỗi danh sách các Lag bị thấp hơn
			VAR _UnderLagsList = CONCATENATEX(_UnderForecastTable, 'fact_flat_forecast_actual'[code_horizon], ", ")
			
			-- 5. Lấy Min/Max để mô tả dải Forecast
			VAR _MinF = MINX(_ForecastTable, [TotalQty])
			VAR _MaxF = MAXX(_ForecastTable, [TotalQty])
			
			RETURN
			IF(
			    ISBLANK(_Actual), 
			    "- "&_QuarterName & ": Data not available",
			    "- "&_QuarterName & ": " & 
			    IF(
			        _CountUnder = 0,
			        "all versions over-forecast (" & FORMAT(_MinF/1000000, "0.0M") & "–" & FORMAT(_MaxF/1000000, "0.0M") & 
			        " vs " & FORMAT(_Actual/1000000, "0.0M") & " actual) — possible demand drop not captured.",
			        "mixed forecast accuracy (" & FORMAT(_MinF/1000000, "0.0M") & "–" & FORMAT(_MaxF/1000000, "0.0M") & 
			        " vs " & FORMAT(_Actual/1000000, "0.0M") & " actual). Under-forecast versions: " & _UnderLagsList & "."
			    )
			)
			```
		displayFolder: 3. Narrative
		lineageTag: 7a7657b0-cda3-4349-92f0-24ac4c4caae7

