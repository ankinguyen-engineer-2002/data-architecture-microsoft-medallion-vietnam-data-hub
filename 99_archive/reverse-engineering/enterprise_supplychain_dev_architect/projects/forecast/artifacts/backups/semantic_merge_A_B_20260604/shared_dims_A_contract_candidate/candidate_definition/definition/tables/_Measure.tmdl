	measure ForecastAccuracy_HorizonCompare_Insight = ```
			
			 VAR is1 = 1  // is declining/ increasing 
			 VAR is2 =  2 // %MAPE 
			 
			 // Khai báo biến so sánh để câu lệnh gọn hơn
			 VAR ErrorComparison = 
			    IF(
			        [Pct_wMAPE_Lag0] < [Pct_wMAPE_Lag3], 
			        "higher error than Lag-0", 
			        IF(
			            [Pct_wMAPE_Lag0] > [Pct_wMAPE_Lag3], 
			            "lower error than Lag-0", 
			            "the same error as Lag-0" // Trường hợp 2 giá trị bằng nhau
			        )
			    )
			
			 RETURN 
			 "Accuracy is declining as the forecast lag increases. Lag-3 shows " & ErrorComparison
			```
