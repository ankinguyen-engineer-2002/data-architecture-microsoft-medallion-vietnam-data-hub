		lineageTag: 9183c56a-7fbd-4aca-a0b1-20fb566db4b8

	/// On-hand value classified as Below Target.
	measure 'Below Target Value at Cost' = CALCULATE ( [On Hand Inventory Value at Cost], FactInventoryHealthSnapshot[InventoryClassification] = "Below Target" )
		formatString: $#,0;($#,0);-
		displayFolder: Surplus\Classification
		lineageTag: bfadd7f4-9530-4ddb-8c8b-6c7e5f30645e

	/// On-hand value classified as Sweet Spot.
	measure 'Sweet Spot Value at Cost' = CALCULATE ( [On Hand Inventory Value at Cost], FactInventoryHealthSnapshot[InventoryClassification] = "Sweet Spot" )
