	/// On-hand value classified as Over Target.
	measure 'Over Target Value at Cost' = CALCULATE ( [On Hand Inventory Value at Cost], FactInventoryHealthSnapshot[InventoryClassification] = "Over Target" )
		formatString: $#,0;($#,0);-
		displayFolder: Surplus\Classification
		lineageTag: 82e77ae8-6179-49df-911c-6facbd35970d

	/// On-hand value classified as SLOB.
	measure 'SLOB Value at Cost' = CALCULATE ( [On Hand Inventory Value at Cost], FactInventoryHealthSnapshot[InventoryClassification] = "SLOB" )
		formatString: $#,0;($#,0);-
		displayFolder: Surplus\Classification
		lineageTag: edb613b3-4e25-41f9-86d7-71d0ad9a814f

	/// On-hand value classified as Inactive.
	measure 'Inactive Value at Cost' = CALCULATE ( [On Hand Inventory Value at Cost], FactInventoryHealthSnapshot[InventoryClassification] = "Inactive" )
		formatString: $#,0;($#,0);-
