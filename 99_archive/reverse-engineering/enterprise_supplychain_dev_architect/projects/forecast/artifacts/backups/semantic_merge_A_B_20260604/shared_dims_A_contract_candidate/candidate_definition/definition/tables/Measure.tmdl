		lineageTag: 467b8705-8767-4c4e-9187-34d1f16678f7

	/// Sweet Spot value share.
	measure 'Sweet Spot %' = DIVIDE ( [Sweet Spot Value at Cost], [On Hand Inventory Value at Cost] )
