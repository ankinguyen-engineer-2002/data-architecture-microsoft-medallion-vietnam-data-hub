		lineageTag: 5dbf7212-6c41-4ab5-bdea-7e300ddb61a0

	/// Mockup-facing shortage quantity.
	measure 'Shortage Qty' = [Shortage Qty - Week Four]
		formatString: #,0
		displayFolder: Risk
