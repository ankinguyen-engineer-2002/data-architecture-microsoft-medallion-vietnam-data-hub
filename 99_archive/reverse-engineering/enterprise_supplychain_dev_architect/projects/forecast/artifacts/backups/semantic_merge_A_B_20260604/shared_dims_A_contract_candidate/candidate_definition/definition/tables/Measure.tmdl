	/// Mockup-facing firm demand at risk alias.
	measure 'Firm Demand at Risk' = [Firm Demand at Risk $ - Week Four]
		formatString: $#,0.0,,M;($#,0.0,,M);-
		displayFolder: Risk\Demand Split
		lineageTag: 1057fba4-61bc-49db-9d5f-0defc0100556

	/// Mockup-facing forecast demand at risk alias.
	measure 'Forecast Demand at Risk' = [Forecast Demand at Risk $ - Week Four]
		formatString: $#,0.0,,M;($#,0.0,,M);-
		displayFolder: Risk\Demand Split
		lineageTag: 85d14058-fd4e-43fb-98a8-37e18e7bcc73

	/// Firm demand share of week-four revenue at risk.
	measure 'Firm Demand at Risk %' = DIVIDE ( [Firm Demand at Risk $ - Week Four], [Revenue at Risk - Week Four] )
		formatString: 0.0%
		displayFolder: Risk\Demand Split
		lineageTag: 61812f7c-c310-427b-b325-f412e77811bf

	/// Forecast demand share of week-four revenue at risk.
	measure 'Forecast Demand at Risk %' = DIVIDE ( [Forecast Demand at Risk $ - Week Four], [Revenue at Risk - Week Four] )
		formatString: 0.0%
		displayFolder: Risk\Demand Split
		lineageTag: ddee57db-71d4-4569-8b44-7b6adb57f103

	/// Mockup-facing surplus amount.
	measure 'Surplus Amount $' = [Surplus Inventory Value at Cost]
		formatString: $#,0.0,,M;($#,0.0,,M);-
		displayFolder: Surplus
		lineageTag: 0e4e8022-9bb7-4588-b4ad-4b02954e7401

	/// Mockup-facing percent surplus measure.
	measure 'Percent Surplus' = [Percent Surplus Classification]
		formatString: 0.0%
