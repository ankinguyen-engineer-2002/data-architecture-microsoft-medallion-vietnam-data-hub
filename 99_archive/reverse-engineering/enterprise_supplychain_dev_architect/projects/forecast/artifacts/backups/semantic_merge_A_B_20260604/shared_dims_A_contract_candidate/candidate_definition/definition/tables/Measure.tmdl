	/// Proxy: active ATP Item-WH count uses active shippable inventory Item-WH count.
	measure 'ATP Active Item-WH Count' = [Active Item-WH Count]
		formatString: #,0
		displayFolder: Forward Service\ATP
		lineageTag: 48309c7a-ba03-4d95-aca4-99a6b9f4e26b

