	measure wMAPE_Lag0_Color = ```
			
			VAR Pct_wMAPE_Lag0 = CALCULATE([Pct_wMAPE_Lag0], ALL(DimForecastHorizon[HorizonCode]))
			VAR Pct_wMAPE_Lag1 = CALCULATE([Pct_wMAPE_Lag1], ALL(DimForecastHorizon[HorizonCode]))
			VAR Pct_wMAPE_Lag2 = CALCULATE([Pct_wMAPE_Lag2], ALL(DimForecastHorizon[HorizonCode] ))
			VAR Pct_wMAPE_Lag3 = CALCULATE([Pct_wMAPE_Lag3], ALL(DimForecastHorizon[HorizonCode]))
			VAR Pct_wMAPE_Lag4 = CALCULATE([Pct_wMAPE_Lag4], ALL(DimForecastHorizon[HorizonCode]))
			VAR CurrentValue = Pct_wMAPE_Lag0
			VAR Rankk =
			    (IF(Pct_wMAPE_Lag0 <= CurrentValue, 1, 0)) +
			    (IF(Pct_wMAPE_Lag1 < CurrentValue, 1, 0)) +
			    (IF(Pct_wMAPE_Lag2 < CurrentValue, 1, 0)) +
			    (IF(Pct_wMAPE_Lag3 < CurrentValue, 1, 0)) +
			    (IF(Pct_wMAPE_Lag4 < CurrentValue, 1, 0)) 
			RETURN
			    SWITCH(
			        Rankk,
			        1, "#2D3419", -- xanh lá 
			        2, "#132234", -- xanh dương 
			        3, "#342A13", -- vàng 
			        4, "#342013", -- cam 
			        5, "#341913" -- đỏ 
			        , "#2A2A2A"
			    )
			```
		displayFolder: 2. Format
		lineageTag: d2786e79-ae79-402a-bc66-6f374196e245

