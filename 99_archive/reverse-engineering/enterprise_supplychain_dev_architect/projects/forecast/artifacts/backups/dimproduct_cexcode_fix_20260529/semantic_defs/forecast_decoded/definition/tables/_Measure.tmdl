	measure Cumulative_Forecast_Bias =
			VAR MaxDateInRow = MAX('DimCalendar'[FSCMonthLast])
			VAR CurrentDate = TODAY()
			RETURN
			CALCULATE(
			    [Qty_Bias],
			    FILTER(
			        ALLSELECTED('DimCalendar'),
			        'DimCalendar'[FSCMonthLast] <= MaxDateInRow &&
			        'DimCalendar'[FSCMonthLast] <= CurrentDate
			    )
			)
		formatString: G
		displayFolder: 1. Main KPIs - Forecast Accuracy
		lineageTag: d40c1d39-a8b8-41a5-b279-2d3005199ef2

