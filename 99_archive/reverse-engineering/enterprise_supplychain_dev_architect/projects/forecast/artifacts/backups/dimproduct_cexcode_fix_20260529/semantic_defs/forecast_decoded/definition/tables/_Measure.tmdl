	measure BestPeformanceHorizon_Insight =
			
			VAR Pct_wMAPE_Lag0 = [Pct_wMAPE_Lag0]
			VAR Pct_wMAPE_Lag1 = [Pct_wMAPE_Lag1]
			VAR Pct_wMAPE_Lag2 = [Pct_wMAPE_Lag2]
			VAR Pct_wMAPE_Lag3 = [Pct_wMAPE_Lag3]
			VAR Pct_wMAPE_Lag4 = [Pct_wMAPE_Lag4]
			VAR bestValue =
			    MIN ( [Pct_wMAPE_Lag0], MIN ( [Pct_wMAPE_Lag1], MIN ( [Pct_wMAPE_Lag2], MIN ( [Pct_wMAPE_Lag3], [Pct_wMAPE_Lag4] ) ) ) )
			RETURN
			SWITCH (
			    TRUE(),
			    [Pct_wMAPE_Lag0] = bestValue, "Lag-0",
			    [Pct_wMAPE_Lag1] = bestValue, "Lag-1",
			    [Pct_wMAPE_Lag2] = bestValue, "Lag-2",
			    [Pct_wMAPE_Lag3] = bestValue, "Lag-3",
			    [Pct_wMAPE_Lag4] = bestValue, "Lag-4" , "To be Defined"
			)
		displayFolder: 3. Narrative
		lineageTag: 292c2a78-e979-4832-97fb-7311df8a12b7

	measure Bias_Status = ```
			
			SWITCH(TRUE() , [qty_bias] < 0 , "UNDER" , 
			 [qty_bias] > 0 , "OVER" , "EQUAL")
			```
		displayFolder: 3. Narrative
		lineageTag: c2539dc0-8fec-42d6-9e37-acc839b66c3f

	measure Dynamic_Forecast_Insight_1_Month = ```
			
			-- 1. Khai báo biến dữ liệu đầu vào
			VAR _wMAPE_Lag3 = [Pct_wMAPE_Lag3]
			VAR _wMAPE_Naive = [Pct_NwMAPE]
			VAR _Qty = [Qty_Bias]
			VAR _NQty = [Qty_NBias]
			VAR _Raw_Min = [SelectedMonth_Min]
			VAR _Raw_Max = [SelectedMonth_Max]
			
			-- 2. Định dạng các con số thành văn bản (Text)
			VAR _Txt_Lag3 = FORMAT(_wMAPE_Lag3, "0.0%")
			VAR _Txt_Naive = FORMAT(_wMAPE_Naive, "0.0%")
			VAR _Txt_Add = FORMAT(ABS(_wMAPE_Lag3 - _wMAPE_Naive) * 100, "0.0") & "pp"
			VAR _Txt_Qty = FORMAT(ABS(_Qty), "#,0")
			VAR _Txt_NQty = FORMAT(ABS(_NQty), "#,0")
			
			-- 3. Logic so sánh Performance (wMAPE thấp hơn = Overperforms)
			VAR _Performance = IF(_wMAPE_Lag3 < _wMAPE_Naive, "overperforms", "underperforms")
			
			-- 4. Logic Bias Status
			VAR _Bias_Status = IF(_Qty < 0, "under-forecasts", "over-forecasts")
			VAR _NBias_Status = IF(_NQty < 0, "under-forecasts", "over-forecasts")
			
			-- 5. Xử lý logic hiển thị Thời gian (The period in vs The period from...to)
			VAR _Month_Min_Txt = FORMAT(_Raw_Min, "MMM yyyy")
			VAR _Month_Max_Txt = FORMAT(_Raw_Max, "MMM yyyy")
			
			VAR _Period_Txt = 
			    IF(
			        _Raw_Min = _Raw_Max, 
			        "The period in " & _Month_Min_Txt, 
			        "The period from " & _Month_Min_Txt & " to " & _Month_Max_Txt
			    )
			
			-- 6. Kết hợp chuỗi bằng dấu & để tránh lỗi Matching Type
			RETURN
			"Lag-3 (wMAPE " & _Txt_Lag3 & ") " & 
			_Performance & " Naive Forecast (N_wMAPE " & _Txt_Naive & ") " & 
			"by " & _Txt_Add & ". " & 
			_Period_Txt & " " & 
			_Bias_Status & " by " & _Txt_Qty & " units, while Naive " & 
			_NBias_Status & " by " & _Txt_NQty & " units."
			```
		displayFolder: 3. Narrative
		lineageTag: 3b2b1ef4-bfb2-4f28-9509-4e96b2c7a39b

	measure Dynamic_Forecast_Insight_1_Quarter = ```
			
			-- 1. Khai báo biến dữ liệu đầu vào
			VAR _wMAPE_Lag3 = [Pct_wMAPE_Lag3]
			VAR _wMAPE_Naive = [Pct_NwMAPE]
			VAR _Qty = [Qty_Bias]
			VAR _NQty = [Qty_NBias]
			VAR _Raw_Min = [SelectedQuarter_Min]
			VAR _Raw_Max = [SelectedQuarter_Max]
			
			-- 2. Định dạng các con số thành văn bản (Text)
			VAR _Txt_Lag3 = FORMAT(_wMAPE_Lag3, "0.0%")
			VAR _Txt_Naive = FORMAT(_wMAPE_Naive, "0.0%")
			VAR _Txt_Add = FORMAT(ABS(_wMAPE_Lag3 - _wMAPE_Naive) * 100, "0.0") & "pp"
			VAR _Txt_Qty = FORMAT(ABS(_Qty), "#,0")
			VAR _Txt_NQty = FORMAT(ABS(_NQty), "#,0")
			
			-- 3. Logic so sánh Performance (wMAPE thấp hơn = Overperforms)
			VAR _Performance = IF(_wMAPE_Lag3 < _wMAPE_Naive, "overperforms", "underperforms")
			
			-- 4. Logic Bias Status
			VAR _Bias_Status = IF(_Qty < 0, "under-forecasts", "over-forecasts")
			VAR _NBias_Status = IF(_NQty < 0, "under-forecasts", "over-forecasts")
			
			-- 5. Xử lý logic hiển thị Thời gian (The period in vs The period from...to)
			VAR _Quarter_Min_Txt = FORMAT(_Raw_Min, "\Qq yyyy")
			VAR _Quarter_Max_Txt = FORMAT(_Raw_Max, "\Qq yyyy")
			
			VAR _Period_Txt = 
			    IF(
			        _Raw_Min = _Raw_Max, 
			        "The period in " & _Quarter_Min_Txt, 
			        "The period from " & _Quarter_Min_Txt & " to " & _Quarter_Max_Txt
			    )
			
			-- 6. Kết hợp chuỗi bằng dấu & để tránh lỗi Matching Type
			RETURN
			"Lag-3 (wMAPE " & _Txt_Lag3 & ") " & 
			_Performance & " Naive Forecast (N_wMAPE " & _Txt_Naive & ") " & 
			"by " & _Txt_Add & ". " & 
			_Period_Txt & " " & 
			_Bias_Status & " by " & _Txt_Qty & " units, while Naive " & 
			_NBias_Status & " by " & _Txt_NQty & " units."
			```
		displayFolder: 3. Narrative
		lineageTag: 989b0d60-85aa-433c-bf6d-11bc5cd37241

	measure ForecastAccuracy_Insight_3_1_Month = ```
			
			VAR CurrentDate = 
			    LOOKUPVALUE(
			        'DimCalendar'[FSCMonthLast], 
			        'DimCalendar'[FSCMonthIndicatorNum], 0
			    )
			VAR FirstDayOfCurrentMonth = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			
			-- Lùi lại 1,2 tháng và 3 tháng
			
			VAR Month_1 = LOOKUPVALUE(
			        'DimCalendar'[FSCMonthLast], 
			        'DimCalendar'[FSCMonthIndicatorNum], -1
			    )
			
			VAR Month_2 = LOOKUPVALUE(
			        'DimCalendar'[FSCMonthLast], 
			        'DimCalendar'[FSCMonthIndicatorNum], -2
			    )
			VAR Month_3 = LOOKUPVALUE(
			        'DimCalendar'[FSCMonthLast], 
			        'DimCalendar'[FSCMonthIndicatorNum], -3
			    )
			
			-- Định dạng nhãn: "Oct 2025"
			VAR Label_M1 = FORMAT(Month_1, "MMM yyyy")
			VAR Label_M2 = FORMAT(Month_2, "MMM yyyy")
			VAR Label_M3 = FORMAT(Month_3, "MMM yyyy")
			
			-- Tính toán cho Tháng -1 (Tháng gần nhất)
			VAR Actual_M1 = 
			    CALCULATE(
			        SUM('FactForecastActual'[Qty]), 
			         'FactForecastActual'[HorizonCode] = "Actual demand",
			         'FactForecastActual'[FSCMonthLast] = Month_1)
			
			-- Tính toán cho Tháng -2 (Tháng gần nhất)
			VAR Lag0_M2 = 
			    CALCULATE(
			        SUM('FactForecastActual'[Qty]), 
			        'FactForecastActual'[HorizonCode] = "Lag-0",
			        'FactForecastActual'[FSCMonthLast] = Month_2
			    )
			VAR Actual_M2 = 
			    CALCULATE(
			        SUM('FactForecastActual'[Qty]), 
			         'FactForecastActual'[HorizonCode] = "Actual demand",
			         'FactForecastActual'[FSCMonthLast] = Month_2)
			
			-- Tính toán cho Tháng -3
			VAR Lag0_M3 = 
			    CALCULATE(
			        SUM('FactForecastActual'[Qty]), 
			        'DimForecastHorizon'[HorizonCode] = "Lag-0",
			        'DimCalendar'[FSCMonthLast] = Month_3
			    )
			VAR Actual_M3 = 
			    CALCULATE(
			        SUM('FactForecastActual'[Qty]), 
			        'DimForecastHorizon'[HorizonCode] = "Actual demand",
			        'DimCalendar'[FSCMonthLast] = Month_3
			    )
			
			-- Định dạng số có dấu phẩy (Thêm units trực tiếp vào định dạng để gọn mã)
			VAR Actual_M1_Fmt = FORMAT(Actual_M1, "#,0") & " units"
			VAR Lag0_M2_Fmt = FORMAT(Lag0_M2, "#,0") & " units"
			VAR Actual_M2_Fmt = FORMAT(Actual_M2, "#,0") & " units"
			VAR Lag0_M3_Fmt = FORMAT(Lag0_M3, "#,0") & " units"
			VAR Actual_M3_Fmt = FORMAT(Actual_M3, "#,0") & " units"
			
			-- Trả về chuỗi kết quả
			RETURN 
			    "- Lag-0 tracks actuals closely: " & 
			    IF(
			        ISBLANK(Lag0_M2) && ISBLANK(Actual_M2), 
			        "No data for " & Label_M2, 
			        Label_M2 & " (" & Lag0_M2_Fmt & " vs " & Actual_M2_Fmt & ")"
			    ) 
			    & ", " & 
			    IF(
			        ISBLANK(Lag0_M3) && ISBLANK(Actual_M3), 
			        "No data for " & Label_M3, 
			        Label_M3 & " (" & Lag0_M3_Fmt & " vs " & Actual_M3_Fmt & ")"
			    ) & ". The actual demand for " & Label_M1 & " is " & Actual_M1_Fmt
			```
