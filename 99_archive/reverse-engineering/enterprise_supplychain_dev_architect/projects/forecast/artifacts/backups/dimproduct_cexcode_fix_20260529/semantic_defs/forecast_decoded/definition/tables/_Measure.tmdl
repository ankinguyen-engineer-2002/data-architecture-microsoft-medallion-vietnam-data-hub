	measure ForecastAccuracy_HorizonCompare_Insight = ```
			
			 VAR is1 = 1  // is declining/ increasing 
			 VAR is2 =  2 // %MAPE 
			 
			 // Khai báo biến so sánh để câu lệnh gọn hơn
			 VAR ErrorComparison = 
			    IF(
			        [Pct_wMAPE_Lag0] < [Pct_wMAPE_Lag3], 
			        "higher error than Lag-0", 
			        IF(
			            [Pct_wMAPE_Lag0] > [Pct_wMAPE_Lag3], 
			            "lower error than Lag-0", 
			            "the same error as Lag-0" // Trường hợp 2 giá trị bằng nhau
			        )
			    )
			
			 RETURN 
			 "Accuracy is declining as the forecast lag increases. Lag-3 shows " & ErrorComparison
			```
		displayFolder: 3. Narrative
		lineageTag: 9a87d040-0121-4eff-8017-d549de722a9e

	measure ForecastAccuracy_lm_Status = ```
			
			VAR CurrentMonthCount =
			    COUNTROWS(VALUES(DimCalendar[FSCMonthYearNum]))
			
			VAR CurrentFA =
			    [Pct_ForecastAccuracy]
			
			VAR CompareFA =
			    [Pct_ForecastAccuracy_lm]
			
			VAR Gap =
			    CurrentFA - CompareFA
			
			VAR FormatGap =
			    FORMAT(Gap, "+0.0%;-0.0%;0.0%")
			
			VAR CompareLabel =
			    IF(CurrentMonthCount = 1, "LM", "Prior Window")
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(CurrentFA) || ISBLANK(CompareFA), BLANK(),
			    Gap > 0, "Growth " & FormatGap & " vs " & CompareLabel,
			    Gap < 0, "Decrease " & FormatGap & " vs " & CompareLabel,
			    "No change vs " & CompareLabel
			)
			 
			```
		displayFolder: 3. Narrative
		lineageTag: aec46bcf-3809-4315-9a1f-1cf80e9fd68f

