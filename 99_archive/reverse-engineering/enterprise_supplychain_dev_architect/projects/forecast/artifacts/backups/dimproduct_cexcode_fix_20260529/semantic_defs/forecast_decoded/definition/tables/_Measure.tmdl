	measure ForecastAccuracy_Insight_3_5_Month = ```
			
			VAR _IndicatorRange = GENERATESERIES(Min(DimCalendar[FSCMonthIndicatorNum]), Max(DimCalendar[FSCMonthIndicatorNum]), 1) -- Tạo dãy số từ -6 đến 0
			
			RETURN
			CONCATENATEX(
			    _IndicatorRange,
			    VAR _CurrentInd = [Value]
			    
			    -- 1. Xác định tháng mục tiêu dựa trên Indicator
			    VAR _TargetMonth = 
			        LOOKUPVALUE(
			            'DimCalendar'[FSCMonthLast], 
			            'DimCalendar'[FSCMonthIndicatorNum], _CurrentInd
			        )
			    VAR _MonthName = FORMAT(_TargetMonth, "mmm yyyy")
			
			    -- 2. Tính Actual của tháng đó
			    VAR _Actual = 
			        CALCULATE(
			            SUM('FactForecastActual'[qty]), 
			            'FactForecastActual'[HorizonCode] = "Actual demand",
			            'FactForecastActual'[FSCMonthLast] = _TargetMonth
			        )
			
			    -- 3. Tạo bảng chứa các Version Forecast (loại bỏ Actual/Naive)
			    VAR _ForecastTable = 
			        FILTER(
			            SUMMARIZE(
			                CALCULATETABLE(
			                    'FactForecastActual',
			                    'FactForecastActual'[FSCMonthLast] = _TargetMonth
			                ),
			                'FactForecastActual'[HorizonCode], 
			                "TotalQty", SUM('FactForecastActual'[qty])
			            ),
			            NOT 'FactForecastActual'[HorizonCode] IN {"Actual demand", "Naive forecast"}
			        )
			
			    -- 4. Lọc các version bị Under-forecast
			    VAR _UnderForecastTable = FILTER(_ForecastTable, [TotalQty] < _Actual)
			    VAR _CountUnder = COUNTROWS(_UnderForecastTable)
			    VAR _TotalVersions = COUNTROWS(_ForecastTable)
			
			    -- 5. Logic xác định "Mixed": Có ít nhất 1 cái thấp hơn và ít nhất 1 cái cao hơn (hoặc đơn giản là không phải tất cả đều cao hơn/thấp hơn)
			    -- Ở đây tôi lấy điều kiện: Có version bị Under nhưng không phải toàn bộ 100% version đều bị Under (Mixed)
			    VAR _IsMixed = _CountUnder > 0 && _CountUnder < _TotalVersions
			
			    -- 6. Format nội dung cho các version bị Under
			    VAR _UnderDetails = 
			        CONCATENATEX(
			            _UnderForecastTable, 
			            'FactForecastActual'[HorizonCode] & " (" & FORMAT([TotalQty]/1000, "#,0K") & ")", 
			            ", "
			        )
			
			    RETURN 
			        IF(
			            _IsMixed && NOT ISBLANK(_Actual),
			            "- Only " & _MonthName & ": Actual " & FORMAT(_Actual/1000, "#,0K") & 
			            " | Under-forecast Lags: " & _UnderDetails,
			            BLANK()
			        ),
			    UNICHAR(10) -- Xuống dòng giữa các tháng
			)
			```
		displayFolder: 3. Narrative
		lineageTag: 67f48986-baf4-4c49-9b79-9c9a7f949f79

	measure ForecastAccuracy_Insight_3_5_Quarter = ```
			
			VAR _IndicatorRange = GENERATESERIES(Min(DimCalendar[FSCQuarterIndicatorNum]), Max(DimCalendar[FSCQuarterIndicatorNum]), 1) -- Tạo dãy số từ -6 đến 0
			
			RETURN
			CONCATENATEX(
			    _IndicatorRange,
			    VAR _CurrentInd = [Value]
			    
			    -- 1. Xác định tháng mục tiêu dựa trên Indicator
			    VAR _TargetQuarter = 
			        LOOKUPVALUE(
			            'DimCalendar'[FSCQuarterLast], 
			            'DimCalendar'[FSCQuarterIndicatorNum], _CurrentInd
			        )
			    VAR _QuarterName = FORMAT(_TargetQuarter, "mmm yyyy")
			
			    -- 2. Tính Actual của quý đó
			    VAR _Actual = 
			        CALCULATE(
			            SUM('FactForecastActual'[qty]), 
			            'FactForecastActual'[HorizonCode] = "Actual demand",
			            'DimCalendar'[FSCQuarterLast] = _TargetQuarter
			        )
			
			    -- 3. Tạo bảng chứa các Version Forecast (loại bỏ Actual/Naive)
			    VAR _ForecastTable = 
			        FILTER(
			            SUMMARIZE(
			                CALCULATETABLE(
			                    'FactForecastActual',
			                    'DimCalendar'[FSCQuarterLast] = _TargetQuarter
			                ),
			                'FactForecastActual'[HorizonCode], 
			                "TotalQty", SUM('FactForecastActual'[qty])
			            ),
			            NOT 'FactForecastActual'[HorizonCode] IN {"Actual demand", "Naive forecast"}
			        )
			
			    -- 4. Lọc các version bị Under-forecast
			    VAR _UnderForecastTable = FILTER(_ForecastTable, [TotalQty] < _Actual)
			    VAR _CountUnder = COUNTROWS(_UnderForecastTable)
			    VAR _TotalVersions = COUNTROWS(_ForecastTable)
			
			    -- 5. Logic xác định "Mixed": Có ít nhất 1 cái thấp hơn và ít nhất 1 cái cao hơn (hoặc đơn giản là không phải tất cả đều cao hơn/thấp hơn)
			    -- Ở đây tôi lấy điều kiện: Có version bị Under nhưng không phải toàn bộ 100% version đều bị Under (Mixed)
			    VAR _IsMixed = _CountUnder > 0 && _CountUnder < _TotalVersions
			
			    -- 6. Format nội dung cho các version bị Under
			    VAR _UnderDetails = 
			        CONCATENATEX(
			            _UnderForecastTable, 
			            'FactForecastActual'[HorizonCode] & " (" & FORMAT([TotalQty]/1000, "#,0K") & ")", 
			            ", "
			        )
			
			    RETURN 
			        IF(
			            _IsMixed && NOT ISBLANK(_Actual),
			            "- Only " & _QuarterName & ": Actual " & FORMAT(_Actual/1000, "#,0K") & 
			            " | Under-forecast Lags: " & _UnderDetails,
			            BLANK()
			        ),
			    UNICHAR(10) -- Xuống dòng giữa các quý
			)
			```
		displayFolder: 3. Narrative
		lineageTag: 73805de2-9195-4034-af0d-ef95bb63f100

