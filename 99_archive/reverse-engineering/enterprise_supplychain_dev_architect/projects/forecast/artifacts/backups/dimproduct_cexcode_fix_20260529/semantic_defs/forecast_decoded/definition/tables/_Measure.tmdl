	measure ForecastAccuracy_Insight_3_2_Month = ```
			
			VAR LatestMonth = 
			    LOOKUPVALUE(
			        'DimCalendar'[FSCMonthLast], 
			        'DimCalendar'[FSCMonthIndicatorNum], 0
			    )
			
			VAR Period3M = 
			    DATESINPERIOD(
			        'DimCalendar'[FSCMonthLast], 
			        LatestMonth, 
			        -3, 
			        MONTH
			    )
			
			-- Use DATATABLE to create a clean, named virtual table
			VAR TargetLags = 
			    DATATABLE(
			        "LagName", STRING, 
			        {
			            {"Lag-0"}, {"Lag-1"}, {"Lag-2"}, {"Lag-3"}, {"Lag-4"}
			        }
			    )
			
			-- Create the virtual table calculating Bias
			VAR BiasTable = 
			    GENERATE(
			        Period3M, 
			        VAR CurrentMonth = [FSCMonthLast]
			        VAR ActualQty = 
			            CALCULATE(
			                SUM(FactForecastActual[qty]),
			                FactForecastActual[HorizonCode] = "Actual demand",
			                FactForecastActual[FSCMonthLast] = CurrentMonth
			            )
			        RETURN
			            SELECTCOLUMNS(
			                TargetLags,
			                "Lag", [LagName],
			                "BiasValue", 
			                    -- Capture the current row's LagName into a variable
			                    VAR CurrentLag = [LagName] 
			                    RETURN
			                    CALCULATE(
			                        SUM(FactForecastActual[qty]),
			                        FactForecastActual[HorizonCode] = CurrentLag,
			                        FactForecastActual[FSCMonthLast] = CurrentMonth
			                    ) - ActualQty
			            )
			    )
			
			RETURN
			    "- Spread across lags stays tight at "&FORMAT(MEDIANX(BiasTable, [BiasValue]),"#,##0")&" units for most months."
			```
		displayFolder: 3. Narrative
		lineageTag: 746f4ff5-4dea-439f-ba8b-a82f69552ace

